# Copy this file to `.env.local` and fill in the values from the Supabase
# dashboard (Project Settings → API). `.env.local` is gitignored — never commit it.
#
# These two values are safe to expose in the browser: the anon key is a public
# identifier, and Row-Level Security in the database is what actually protects
# the data (see supabase/schema.sql). They are kept out of the repo as hygiene,
# so credentials live in one place and can be rotated without a code change.
#
# NEVER put the service_role / secret key in here. Vite inlines every VITE_*
# variable into the public bundle, so that key would be handed to every visitor.
# It bypasses all security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
